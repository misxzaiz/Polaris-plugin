{
  "id": "bundle-lens",
  "name": "包体积透视台",
  "version": "0.1.0",
  "description": "把「这个前端包为什么这么大、谁占的、有没有重复依赖」从装插件改构建配置变成一次 60 秒的本地透视：指向任意构建产物目录（vite/webpack/esbuild/rollup 通吃，零配置零侵入），解析 sourcemap 做字节级归因——每个 chunk 里每个源文件/每个 npm 包占多少字节、vendor vs 应用代码占比、treemap 面积图；重复依赖三连检（同包多版本/多来源、同一源文件打进多个 chunk、不同路径完全相同内容）；确定性建议（moment 全量 locale、core-js 全量 polyfill、单 chunk 过大、未归因占比过高等）；扫描历史自动 diff（优化前后逐包对比）。sourcemap 含源码——全程不出本机。AI 经 MCP 七工具对话式透视（bundle_scan/report/packages/duplicates/chunks/diff/selftest）。只读零外网，报告经 cap.kv 投影三端同看。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "bundle-lens.panel",
        "area": "activityBar",
        "panelType": "bundleLens",
        "icon": "Target",
        "labelKey": "plugins.bundleLens",
        "labelDefault": "包体积透视台",
        "order": 93
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "bundle-lens-server",
        "type": "http",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/service/main.js", "{{port}}", "{{appConfigDir}}"],
        "port": 9880,
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 10,
        "description": "包体积透视引擎（127.0.0.1 监听；sourcemap 字节级归因 + 包分组 + 重复检测 + treemap 布局 + kv 投影；REST API）"
      }
    ],
    "mcpServers": [
      {
        "id": "bundle-lens",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js", "{{appConfigDir}}"]
      }
    ]
  },
  "permissions": {
    "appConfigRead": true,
    "network": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/bundle-lens",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/bundle-lens/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/bundle-lens/bundle-lens.zip"
  }
}
