{
  "id": "ai-scheduler",
  "name": "AI 定时任务",
  "version": "1.0.0",
  "description": "AI 会话级定时任务台：到点自动构建提示词并驱动宿主 AI 引擎执行。支持 once/cron/interval/after_completion 四种触发、协议模式任务书（.polaris/tasks 文档驱动）、提示词模板、工作区绑定与执行历史。与轻量动作台 task-runner 分工：本插件执行的是宿主 AI 引擎会话（可在聊天界面看到执行过程），非一次性动作。",
  "author": "quan",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "ai-scheduler.panel",
        "area": "activityBar",
        "panelType": "ai-scheduler",
        "icon": "Clock",
        "labelKey": "labels.schedulerPanel",
        "labelDefault": "AI 定时任务",
        "order": 50
      }
    ],
    "panel": {
      "entry": "./dist/panel.js"
    },
    "services": [
      {
        "id": "ai-scheduler-service",
        "type": "http",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/service/main.js", "{{port}}", "{{appConfigDir}}"],
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 10,
        "description": "调度守护：轮询到期任务、构建提示词、经 cap.ai.chat 触发宿主 AI 执行、WS 订阅终态回收"
      }
    ],
    "mcpServers": [
      {
        "id": "ai-scheduler-mcp",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js", "{{appConfigDir}}"],
        "description": "定时任务管理工具：任务的增删改查与启停"
      }
    ]
  },
  "permissions": {
    "appConfigRead": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/ai-scheduler",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/ai-scheduler/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@ai-scheduler-v1.0.0/plugins/ai-scheduler/ai-scheduler.zip"
  }
}
