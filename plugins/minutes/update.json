{
  "id": "polaris.minutes",
  "name": "Minutes Craft",
  "version": "1.0.0",
  "description": "会议纪要/周报/standup 结构化工作台：AI 按模板提炼转写笔记为议题/决策/任务，Panel 编辑导出 Markdown，ChatCard 分节渲染。bot-free、不限时长、本地隐私。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "minutes.panel",
        "area": "activityBar",
        "panelType": "minutesCraft",
        "icon": "ClipboardList",
        "labelKey": "labels.minutesPanel",
        "labelDefault": "Minutes",
        "order": 84
      }
    ],
    "panel": {
      "entry": "./dist/panel.js"
    },
    "mcpServers": [
      {
        "id": "minutes-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js"]
      }
    ],
    "chatCards": [
      {
        "id": "minutes-card",
        "mcpServerId": "minutes-server",
        "tools": ["structure_minutes"],
        "mode": "result",
        "entry": "./dist/card.js"
      }
    ]
  },
  "permissions": {
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/minutes",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/minutes/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/minutes/minutes.zip"
  }
}
