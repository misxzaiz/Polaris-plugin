{
  "id": "polaris-api-client",
  "name": "Polaris API Client",
  "version": "1.0.0",
  "description": "专业 HTTP 请求客户端：多 Tab、环境变量、集合管理、cURL 导入导出、跨域代理、智能响应（对象树/表格/路径下钻/增强过滤）、模板接口、服务器选择器、Auth 认证、全局 Headers、代码生成、AI 协同",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "polaris-api-client.panel",
        "area": "activityBar",
        "panelType": "polarisApiClient",
        "icon": "Terminal",
        "labelKey": "plugins.polarisApiClient",
        "labelDefault": "API",
        "order": 82
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "polaris-api-client-proxy",
        "type": "http",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/server.js", "{{port}}"],
        "port": 9861,
        "healthCheck": "/__health",
        "healthCheckTimeout": 3000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 3,
        "description": "Polaris API Client 代理服务（跨域转发 /__proxy）"
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "network": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/polaris-api-client",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/polaris-api-client/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/polaris-api-client/polaris-api-client.zip"
  }
}