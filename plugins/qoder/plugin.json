{
  "id": "qoder",
  "name": "Qoder Engine",
  "version": "0.2.1",
  "description": "Qoder AI CLI 引擎适配器（engine-v1，claude-code stream-json 协议同构）。v0.2.1：resume_token 采集竞态修复（stdout drain 完才收尾）+ --resume 兼容（续聊链路就绪）；错误透出（模型不可用/限流在聊天内可见）。需先 qodercli login 登录；当前 qoder 服务端账号模型波动期间推理不可用，服务恢复即用。",
  "enabledByDefault": false,
  "contributes": {
    "engines": [
      {
        "id": "qoder",
        "name": "Qoder",
        "description": "Qoder AI CLI — AI 编程助手（需 qodercli login 登录）",
        "cli": {
          "command": "qodercli",
          "args": [],
          "installGuide": "npm install -g @qoder-ai/qodercli"
        },
        "npmPackage": "@qoder-ai/qodercli",
        "protocol": "command",
        "sessionFlags": "omp",
        "mcpConsumption": "none",
        "sessionConfig": {
          "selectors": [
            "agent",
            "model",
            "effort",
            "permission",
            "profile"
          ],
          "effortOptions": [
            {
              "value": "",
              "label": "不设置",
              "description": "使用 CLI 默认级别"
            },
            {
              "value": "low",
              "label": "低",
              "description": "快速响应"
            },
            {
              "value": "medium",
              "label": "中",
              "description": "平衡速度和质量"
            },
            {
              "value": "high",
              "label": "高",
              "description": "深入思考"
            }
          ],
          "permissionOptions": [
            {
              "value": "",
              "label": "不设置",
              "description": "使用 CLI 默认权限策略"
            },
            {
              "value": "default",
              "label": "默认",
              "description": "敏感操作需要确认"
            },
            {
              "value": "auto",
              "label": "自动",
              "description": "安全操作自动批准"
            },
            {
              "value": "acceptEdits",
              "label": "接受编辑",
              "description": "自动接受文件编辑"
            },
            {
              "value": "dontAsk",
              "label": "拒绝危险",
              "description": "拒绝需要确认的危险操作"
            },
            {
              "value": "bypassPermissions",
              "label": "跳过权限（高风险）",
              "description": "绕过所有权限检查"
            }
          ]
        },
        "adapter": {
          "entry": "adapter.js",
          "runtime": "node",
          "protocol": "engine-v1"
        },
        "capabilities": {
          "tools": true,
          "streaming": true,
          "interrupt": true,
          "resume": true
        }
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "aiToolAccess": true
  }
}
