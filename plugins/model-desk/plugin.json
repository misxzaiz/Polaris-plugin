{
  "id": "model-desk",
  "name": "模型管理台",
  "version": "0.1.0",
  "description": "把「加一个模型供应商、测一个端点通不通、看这个月 Token 花在哪」从改 config.json + 手工 curl 变成本地面板闭环：模型 Profile 增删改/激活/连接测试/端点拉模型列表/预设画廊/快捷输入，Token 用量看板（汇总/模型/引擎/日趋势/明细，时间范围筛选）。数据面走 cap.config（modelProfiles）与 usage_* 命令，凭证不出本机。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "model-desk.panel",
        "area": "activityBar",
        "panelType": "model-desk",
        "icon": "Server",
        "labelKey": "plugins.modelDesk",
        "labelDefault": "模型管理台",
        "order": 97
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": false
    }
  },
  "permissions": {},
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/model-desk",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/model-desk/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/model-desk/model-desk.zip"
  }
}
