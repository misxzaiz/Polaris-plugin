{
  "name": "imgforge-panel",
  "version": "0.1.0",
  "private": true,
  "description": "imgforge 插件（打包用）：图片工坊——本地批量图片变换引擎",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=esm --outfile=dist/panel.js --jsx=automatic --external:react --external:react/jsx-runtime",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@img/sharp-wasm32": "^0.35.5",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.5.0"
  }
}
