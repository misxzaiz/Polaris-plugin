{
  "name": "pdf-tables-panel",
  "version": "0.1.0",
  "private": true,
  "description": "pdf-tables 插件面板（打包用）：表格提取台 PDF 表格→Excel/CSV",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=esm --outfile=dist/panel.js --jsx=automatic --external:react --external:react/jsx-runtime",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.23.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.5.0"
  }
}
