{
  "id": "polaris.ngrok-manager",
  "name": "ngrok Manager",
  "version": "1.0.0",
  "description": "按端口启动/管理多个 ngrok HTTP 隧道:随机或固定保留域名,公网 URL 一键复制/打开,AI 可经 MCP 工具调用。需电脑预装 ngrok 并配置 authtoken。",
  "enabledByDefault": true,
  "contributes": {
    "views": [{
      "id": "ngrok-manager.panel",
      "area": "activityBar",
      "panelType": "ngrokManager",
      "icon": "Terminal",
      "labelKey": "plugins.ngrokManager",
      "labelDefault": "ngrok",
      "order": 86
    }],
    "panel": {
      "entry": "./dist/panel.js"
    },
    "mcpServers": [{
      "id": "ngrok-manager-mcp",
      "transport": "stdio",
      "command": "node",
      "argsTemplate": ["{{pluginDir}}/mcp/server.js", "{{pluginDir}}"]
    }],
    "services": [{
      "id": "ngrok-manager-http",
      "type": "http",
      "command": "node",
      "argsTemplate": ["{{pluginDir}}/server.js", "{{port}}", "{{pluginDir}}"],
      "port": 9870,
      "healthCheck": "/__health",
      "healthCheckTimeout": 8000,
      "autoStart": true,
      "restartOnFailure": true,
      "maxRestarts": 5,
      "description": "ngrok 隧道管理器"
    }]
  },
  "permissions": {
    "aiToolAccess": true,
    "network": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/ngrok-manager",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/ngrok-manager/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/ngrok-manager/ngrok-manager.zip"
  }
}
