{
  "name": "yaml-lens-panel",
  "version": "0.1.0",
  "private": true,
  "description": "yaml-lens 插件（打包用）：YAML 调试台——解析预览/坑检测/JSON 互转",
  "scripts": {
    "build:mcp": "esbuild mcp/server-src.js --bundle --platform=node --format=cjs --outfile=mcp/server.js",
    "build:panel": "esbuild src/index.tsx --bundle --format=esm --outfile=dist/panel.js --jsx=automatic --external:react --external:react/jsx-runtime",
    "build": "npm run build:mcp && npm run build:panel",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-tests.mjs && node test/mcp-verify.mjs && node test/ssr-verify.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "esbuild": "^0.23.0",
    "js-yaml": "4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.5.0"
  },
  "type": "commonjs"
}
