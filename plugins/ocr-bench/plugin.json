{
  "id": "ocr-bench",
  "name": "文字识别台",
  "version": "0.1.0",
  "description": "把「图片/扫描版 PDF 里的文字」变成可复制、可搜索、可交给 AI 继续加工的文本——全本地识别零上传（Tesseract 内核，内置简体中文+英语，16 种语言按需下载），支持批量目录、扫描 PDF 整卷（自动检测文字层：文字版直读不烧 OCR）、识别结果一键导出 txt 或直接进对话加工。护栏（单任务≤200 文件/PDF≤500 页/单图≤50MB/单任务互斥可中止）+ 输出目录根边界校验。AI 六工具一句话识别并取全文（ocr_scan/status/stop/result/history/langs），唯一外网流量是语言包模型文件本身，图像数据永不外发。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "ocr-bench.panel",
        "area": "activityBar",
        "panelType": "ocrBench",
        "icon": "Languages",
        "labelKey": "plugins.ocrBench",
        "labelDefault": "文字识别台",
        "order": 87
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "ocr-bench-service",
        "type": "http",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/service/main.js",
          "{{port}}",
          "{{appConfigDir}}"
        ],
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 10,
        "description": "本地 OCR 引擎（127.0.0.1 + token）：tesseract.js + pdfjs 页图提取 + 任务调度 + 报告落 kv（ocr-bench.* 单写者）"
      }
    ],
    "mcpServers": [
      {
        "id": "ocr-bench",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js",
          "{{appConfigDir}}"
        ]
      }
    ]
  },
  "permissions": {
    "appConfigRead": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/ocr-bench",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/ocr-bench/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/ocr-bench/ocr-bench.zip"
  }
}
