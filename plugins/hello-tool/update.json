{
  "id": "polaris.example.hello",
  "name": "Hello Tool",
  "version": "1.0.0",
  "description": "最小可安装插件示例：贡献一个 MCP 工具 echo。",
  "enabledByDefault": true,
  "contributes": {
    "mcpServers": [
      {
        "id": "hello-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js"]
      }
    ]
  },
  "permissions": { "aiToolAccess": true },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/hello-tool",
    "updateUrl": "https://raw.githubusercontent.com/misxzaiz/Polaris-plugin/main/plugins/hello-tool/update.json",
    "downloadUrl": "https://raw.githubusercontent.com/misxzaiz/Polaris-plugin/main/plugins/hello-tool/hello-tool.zip"
  }
}
