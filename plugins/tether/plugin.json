{
  "id": "tether",
  "name": "故人",
  "version": "0.1.0",
  "description": "把「人」变成可对话的资产：故人档案（关系/生日/联系渠道/交往节奏）、往来流水（联系/便签/人情往来）、双向承诺闭环（我许的/我等的，逾期红临期黄）、失联预警（按各自节奏的可解释衰减榜：N 天未联系 vs 节奏 M 天）、见面简报（见人前一份上下文包：档案+最近往来+未闭环承诺+人情天平）。AI 经 12 个 ren_* MCP 工具口语化管理——「我答应小张周五给方案」立诺、「上周和王总聊了啥」查流水、「明天见客户张总」出简报。纯本地人脉账本（cap.kv，数据不出设备）：零后台服务、零网络请求，浏览器跨域面为零；面板与 AI 经同一计算核心（shared/tether-core）保证口径一致；桌面与手机 Web 看到同一本账。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "tether.panel",
        "area": "activityBar",
        "panelType": "tether",
        "icon": "Users",
        "labelKey": "plugins.tether",
        "labelDefault": "故人",
        "order": 84
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "mcpServers": [
      {
        "id": "tether",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js", "{{appConfigDir}}"]
      }
    ]
  },
  "permissions": {
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/tether",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/tether/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/tether/tether.zip"
  }
}
