{
  "id": "polaris.marketplace",
  "name": "Polaris 插件商城",
  "version": "1.5.0",
  "description": "在 Polaris 内浏览、搜索并一键安装本商城索引中的插件。单视图「插件市场」：已装为筛选 chip 与分类/搜索叠加，详情为面板内 push 覆盖层，按安装状态分流（未装：版本选择+安装到 User/Project；已装：检查更新/应用更新/卸载）。列表徽标含「已装 vX」「可更新至 vX」，双独立评分维度（🔧 功能 tier / ⭐ 使用 usageTier）各自排序与徽标，平铺/按分类分组可切换。手机/远程端直连商城源失败时自动经桌面 MCP proxy_fetch 中转，本地商城源（127.0.0.1:8787）远程可达。提供 ActivityBar 面板与 MCP 工具。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "marketplace.panel",
        "area": "activityBar",
        "panelType": "marketplace",
        "icon": "BookOpen",
        "labelKey": "labels.marketplacePanel",
        "labelDefault": "Marketplace",
        "order": 90
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "mcpServers": [
      {
        "id": "marketplace-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js"
        ]
      }
    ]
  },
  "permissions": {
    "aiToolAccess": true,
    "network": true,
    "appConfigRead": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/marketplace",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/marketplace/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/marketplace/marketplace.zip"
  }
}
