{
  "id": "guanzhi",
  "name": "书影音账本",
  "version": "0.1.0",
  "description": "常驻工作台的书影音消费账本：把「看过的/读过的/玩过的」变成可对话、可复盘、会主动帮你挑下一部的活资产。对话式记账（「昨晚看完《流浪地球2》打9分」一句话入账，AI 凭常识补全年份/导演/类型，同体裁同名自动判重转状态）、想看清单被激活（今晚看什么→躺龄越久越优先+逐日轮换的确定性推荐，附口味画像）、进行中收尾提醒、年报（完成数/评分均值/月度节奏/分体裁/年度十佳/心头好/最长短评）、CSV/JSON 导出与 JSON 导入。面板与 AI（7 个 MCP 工具）经 cap.kv 共享同一事实库。纯本地台账：零后台服务、零网络权限、数据不出设备，桌面与手机 Web 同看一份。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "guanzhi.panel",
        "area": "activityBar",
        "panelType": "guanzhi",
        "icon": "Film",
        "labelKey": "plugins.guanzhi",
        "labelDefault": "书影音账本",
        "order": 87
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "mcpServers": [
      {
        "id": "guanzhi",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js",
          "{{appConfigDir}}"
        ]
      }
    ]
  },
  "permissions": {
    "appConfigRead": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/guanzhi",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/guanzhi/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/guanzhi/guanzhi.zip"
  }
}
