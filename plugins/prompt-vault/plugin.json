{
  "id": "polaris.promptvault",
  "name": "Prompt Vault",
  "version": "1.0.0",
  "description": "本地 prompt 版本库：保存/渲染/对比 prompt 模板，变量注入试运行，版本快照防回归。服务 agent 开发者的 prompt 管理痛点。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "promptvault.panel",
        "area": "activityBar",
        "panelType": "promptVault",
        "icon": "BookOpen",
        "labelKey": "labels.promptVaultPanel",
        "labelDefault": "Prompts",
        "order": 85
      }
    ],
    "panel": {
      "entry": "./dist/panel.js"
    },
    "mcpServers": [
      {
        "id": "promptvault-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js", "{{appConfigDir}}"]
      }
    ],
    "chatCards": [
      {
        "id": "promptvault-card",
        "mcpServerId": "promptvault-server",
        "tools": ["render_prompt"],
        "mode": "result",
        "entry": "./dist/card.js"
      }
    ]
  },
  "permissions": {
    "aiToolAccess": true,
    "appConfigRead": true,
    "appConfigWrite": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/prompt-vault",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/prompt-vault/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/prompt-vault/prompt-vault.zip"
  }
}
