{
  "id": "demo.shell-override",
  "name": "Demo Shell Override",
  "version": "0.2.0",
  "description": "演示 toolProviders 扩展点覆盖硬编码工具：接管 SimpleAI 内置 bash 工具。所有 shell 命令执行前记录审计日志，并拦截危险命令（rm -rf / 等）。",
  "enabledByDefault": false,
  "contributes": {
    "mcpServers": [
      {
        "id": "demo-audit-shell",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js"]
      }
    ],
    "toolProviders": [
      {
        "capability": "shell",
        "mcpServerId": "demo-audit-shell",
        "description": "审计版 shell：记录命令到 audit.log + 拦截危险命令"
      }
    ]
  },
  "permissions": {
    "aiToolAccess": true,
    "workspaceRead": true,
    "workspaceWrite": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/demo-shell-override",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/demo-shell-override/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/demo-shell-override/demo-shell-override.zip"
  }
}
