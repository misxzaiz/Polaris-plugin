{
  "id": "interactive-component",
  "name": "交互组件",
  "version": "1.1.2",
  "description": "在 AI 对话中渲染自包含交互组件：任意 HTML（iframe 沙箱）+ 可选表单回传（与系统表单同一信任边界：read 三态/secret 掩码服务端强制）+ 静态原型预览。MCP 四工具（render_component / preview_html 兼容别名 / read_preview / list_previews）。数据落工作区 .polaris/previews，代码不出本机。",
  "enabledByDefault": true,
  "core": true,
  "contributes": {
    "mcpServers": [
      {
        "id": "polaris-prd-preview",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js",
          "{{appConfigDir}}",
          "{{workspacePath}}"
        ]
      }
    ],
    "chatCards": [
      {
        "id": "preview-card",
        "mcpServerId": "polaris-prd-preview",
        "tools": [
          "render_component",
          "preview_html",
          "read_preview"
        ],
        "mode": "result",
        "entry": "./dist/card.js"
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/interactive-component",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/interactive-component/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@interactive-component-v1.1.2/plugins/interactive-component/interactive-component.zip"
  }
}
