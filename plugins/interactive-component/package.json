{
  "name": "interactive-component-plugin",
  "version": "1.1.0",
  "private": true,
  "description": "交互组件插件打包（对话内自包含交互组件：任意 HTML 沙箱渲染 + 可选表单回传）",
  "scripts": {
    "build": "esbuild src/card.tsx --bundle --format=esm --outfile=dist/card.js --jsx=automatic --external:react --external:react/jsx-runtime --external:polaris-host/artifact --external:polaris-host/form --external:polaris-host/cap",
    "test": "node test/run-tests.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "clsx": "^2.1.1",
    "esbuild": "^0.23.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
