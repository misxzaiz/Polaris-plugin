{
  "id": "opts.zcode-bridge",
  "name": "ZCode 会话桥接",
  "version": "0.1.3",
  "description": "桥接已安装 ZCode 桌面版会话：AI 可通过 MCP 工具在 Polaris 中新建/续接 ZCode 会话（app-server --stdio 官方协议），会话落盘到 ~/.zcode/cli/db/db.sqlite 后桌面端可见。v0.1.3：引擎支持模型选择——Profile 的端点/密钥/模型经 env 注入引擎，生成插件私有 personal provider 配置（不污染桌面配置）并按轮 session/setModel 切换（套餐 API Key 与自建端点同路，自建 V4 握手 fail-open）；reasoningLevel 阶梯自动补齐；引擎改为自持 app-server（不再依赖 9862 面板桥）且退出回收子进程；观察目录沉淀 modelId→providerId 与档位。",
  "enabledByDefault": false,
  "contributes": {
    "views": [
      {
        "id": "zcode-bridge.panel",
        "area": "activityBar",
        "panelType": "zcodeBridge",
        "icon": "GitPullRequest",
        "labelKey": "plugins.zcodeBridge",
        "labelDefault": "ZCode",
        "order": 90
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": false
    },
    "mcpServers": [
      {
        "id": "zcode-bridge-mcp",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js"
        ]
      }
    ],
    "services": [
      {
        "id": "zcode-bridge-http",
        "type": "http",
        "command": "node",
        "port": 9862,
        "argsTemplate": [
          "{{pluginDir}}/server.js",
          "{{port}}",
          "{{pluginDir}}",
          "{{appConfigDir}}"
        ],
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 3,
        "description": "ZCode 会话读取服务（面板用）"
      }
    ],
    "engines": [
      {
        "id": "zcode",
        "name": "ZCode (本地桌面)",
        "description": "桥接已安装 ZCode：在 Polaris 主对话直接使用 ZCode 会话（本地桌面 app-server 协议）",
        "cli": {
          "command": "{{pluginDir}}/mcp/engine-launcher.cmd",
          "args": [],
          "installGuide": "需本机已安装 ZCode 桌面版（默认 D:/app/ZCode）。引擎通过插件内的 engine-launcher.cmd 转发至 mcp/engine.js，由它连接 ZCode 桌面版 app-server。"
        },
        "protocol": "pi-rpc",
        "sessionFlags": "pi",
        "capabilities": {
          "tools": true,
          "streaming": true,
          "interrupt": false,
          "resume": true
        }
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "network": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/zcode-bridge",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/zcode-bridge/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@zcode-bridge-v0.1.3/plugins/zcode-bridge/zcode-bridge.zip"
  }
}
