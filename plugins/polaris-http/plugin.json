{
  "id": "polaris-http",
  "name": "Polaris HTTP",
  "version": "1.1.0",
  "description": "轻量级 API 请求客户端：多 Tab、智能响应（对象树/表格/路径下钻/增强过滤）、集合管理、cURL/Postman/OpenAPI 导入、代码生成、AI 协同、定制接口模板",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "polaris-http.panel",
        "area": "activityBar",
        "panelType": "polarisHttp",
        "icon": "Terminal",
        "labelKey": "plugins.polarisHttp",
        "labelDefault": "HTTP",
        "order": 86
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "polaris-http-proxy",
        "type": "http",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/server.js", "{{port}}"],
        "port": 9872,
        "healthCheck": "/__health",
        "healthCheckTimeout": 3000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 3,
        "description": "Polaris HTTP 代理服务（跨域转发 + 健康检查）"
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "network": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/polaris-http",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/polaris-http/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/polaris-http/polaris-http.zip"
  }
}