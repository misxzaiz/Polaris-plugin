{
  "id": "polaris.diagram",
  "name": "Diagram Studio",
  "version": "1.0.0",
  "description": "对话式图表工作台：AI 用自然语言生成 Mermaid 图表，ChatCard 渲染，Panel 提供编辑、实时预览与 SVG/PNG 导出。服务 agent 开发者（架构/时序图）、学生（思维导图/笔记配图）、上班族（流程图/汇报）。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "diagram.panel",
        "area": "activityBar",
        "panelType": "diagramStudio",
        "icon": "Code2",
        "labelKey": "labels.diagramPanel",
        "labelDefault": "Diagram",
        "order": 82
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "mcpServers": [
      {
        "id": "diagram-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js"]
      }
    ],
    "chatCards": [
      {
        "id": "diagram-card",
        "mcpServerId": "diagram-server",
        "tools": ["generate_diagram"],
        "mode": "result",
        "entry": "./dist/card.js"
      }
    ]
  },
  "permissions": {
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/diagram",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/diagram/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/diagram/diagram.zip"
  }
}
