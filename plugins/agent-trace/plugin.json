{
  "id": "polaris.agenttrace",
  "name": "Agent Trace",
  "version": "1.0.0",
  "description": "MCP 工具调用追踪器：记录 AI agent 调用工具的入参/出参/耗时/错误，时间线可视化，导出 JSONL/CSV。调试不透明 stdio 边界与 schema 漂移痛点。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "agenttrace.panel",
        "area": "activityBar",
        "panelType": "agentTrace",
        "icon": "Activity",
        "labelKey": "labels.agentTracePanel",
        "labelDefault": "Trace",
        "order": 87
      }
    ],
    "panel": { "entry": "./dist/panel.js" },
    "mcpServers": [
      {
        "id": "agenttrace-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js", "{{appConfigDir}}"]
      }
    ],
    "chatCards": [
      {
        "id": "agenttrace-card",
        "mcpServerId": "agenttrace-server",
        "tools": ["query_traces"],
        "mode": "result",
        "entry": "./dist/card.js"
      }
    ]
  },
  "permissions": {
    "aiToolAccess": true,
    "appConfigRead": true,
    "appConfigWrite": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/agent-trace",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/agent-trace/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/agent-trace/agent-trace.zip"
  }
}
