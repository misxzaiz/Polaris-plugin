{
  "id": "polaris.habit",
  "name": "Habit Tracker",
  "version": "1.0.0",
  "description": "习惯追踪与定时打卡：Service 定时检查到期习惯，ChatCard 交互式询问打卡，Panel 统计连续天数。服务上班族喝水/站立/专注习惯养成。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "habit.panel",
        "area": "activityBar",
        "panelType": "habitTracker",
        "icon": "Target",
        "labelKey": "labels.habitPanel",
        "labelDefault": "Habits",
        "order": 89
      }
    ],
    "panel": { "entry": "./dist/panel.js" },
    "mcpServers": [
      {
        "id": "habit-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js"]
      }
    ],
    "services": [
      {
        "id": "habit-svc",
        "type": "http",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/service.js", "{{port}}", "{{appConfigDir}}"],
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 3,
        "description": "Habit Tracker 持久化与到期调度服务"
      }
    ],
    "chatCards": [
      {
        "id": "habit-card",
        "mcpServerId": "habit-server",
        "tools": ["check_due"],
        "mode": "interaction",
        "entry": "./dist/card.js"
      }
    ]
  },
  "permissions": { "aiToolAccess": true, "network": true, "appConfigRead": true, "appConfigWrite": true },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/habit",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/habit/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/habit/habit.zip"
  }
}
