{
  "id": "polaris.knowledge",
  "name": "Knowledge Base",
  "version": "1.0.0",
  "description": "本地知识库与全文检索：笔记/片段存入，按标签与全文搜索，AI 可调用查询工具注入上下文。服务学生笔记、上班族文档、开发者片段的统一检索。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "knowledge.panel",
        "area": "activityBar",
        "panelType": "knowledgeBase",
        "icon": "BookOpen",
        "labelKey": "labels.knowledgePanel",
        "labelDefault": "Knowledge",
        "order": 88
      }
    ],
    "panel": { "entry": "./dist/panel.js" },
    "mcpServers": [
      {
        "id": "knowledge-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js", "{{appConfigDir}}"]
      }
    ],
    "chatCards": [
      {
        "id": "knowledge-card",
        "mcpServerId": "knowledge-server",
        "tools": ["search_notes"],
        "mode": "result",
        "entry": "./dist/card.js"
      }
    ]
  },
  "permissions": { "aiToolAccess": true, "appConfigRead": true, "appConfigWrite": true },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/knowledge",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/knowledge/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/knowledge/knowledge.zip"
  }
}
