{
  "name": "stack-lens-panel",
  "version": "0.1.0",
  "private": true,
  "description": "stack-lens 插件（构建用）：堆栈还原台——minified 错误栈 × sourcemap 逐帧还原源码位置与代码帧",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=esm --outfile=dist/panel.js --jsx=automatic --external:react --external:react/jsx-runtime",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
