{
  "id": "daw-studio",
  "name": "AI 乐谱工作台",
  "version": "0.1.0",
  "description": "让 AI 用乐谱数据自动作曲与记谱：骨架（调式/BPM/和弦进行/风格）经确定性旋律引擎展开成 100% 在调上的乐谱，或 AI 直接精确记谱（strict validator 把关，MIDI 号/音名兼容）；score_analyze 谱面自查闭环（轨外音/同拍叠音/节奏密度/人话建议）。面板（桌面+手机）lookahead 精确调度演奏（波形/滤波/摆动/多八度钢琴卷帘）、试听微调、导出 WAV/MIDI（拖进 FL/Cubase）。MCP 七工具对话式谱写管理（score_create/write/get/list/analyze/delete/export）。语音合成 ≠ 音乐创作：mimo-tts 是说话，这里是音符级作曲。零出网，曲谱全文落本地。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "daw-studio.panel",
        "area": "activityBar",
        "panelType": "dawStudio",
        "icon": "Clock",
        "labelKey": "plugins.dawStudio",
        "labelDefault": "AI 乐谱工作台",
        "order": 90
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "daw-studio-server",
        "type": "http",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/service/main.js",
          "{{port}}",
          "{{appConfigDir}}"
        ],
        "port": 9878,
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 10,
        "description": "乐谱工作台引擎（127.0.0.1 监听；曲谱 CRUD + validator + 谱面分析 + kv 索引投影；零出网）"
      }
    ],
    "mcpServers": [
      {
        "id": "daw-studio",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js",
          "{{appConfigDir}}"
        ]
      }
    ]
  },
  "permissions": {
    "appConfigRead": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/daw-studio",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/daw-studio/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/daw-studio/daw-studio.zip"
  }
}
