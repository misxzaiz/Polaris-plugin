{
  "id": "mimo-tts",
  "name": "MiMo 语音合成",
  "version": "0.1.1",
  "description": "小米 MiMo-V2.5-TTS 系列语音合成（限时免费）：预置音色/文本设计音色/音色克隆。MCP 工具 + 配置面板 + 聊天音频卡片。v0.1.1：面板 API 调用改道宿主 cap.http 转发（面板/Web/移动端跨域不再被 CORS 拦截）；voiceclone 样本上限 10MB + DataURL 校验修复。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "mimo-tts.panel",
        "area": "activityBar",
        "panelType": "mimo-tts",
        "icon": "Activity",
        "labelKey": "labels.mimoTtsPanel",
        "labelDefault": "语音合成",
        "order": 85
      }
    ],
    "panel": {
      "entry": "./dist/panel/panel.js",
      "supportsFullscreen": true
    },
    "mcpServers": [
      {
        "id": "mimo-tts",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js",
          "{{appConfigDir}}",
          "{{pluginDir}}"
        ]
      }
    ],
    "services": [
      {
        "id": "mimo-tts-audio",
        "type": "http",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/http-server.js",
          "{{port}}",
          "{{pluginDir}}"
        ],
        "port": 9861,
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 3,
        "description": "MiMo TTS 音频静态服务（供面板与聊天卡片播放音频）"
      }
    ],
    "chatCards": [
      {
        "id": "mimo-tts.result",
        "mcpServerId": "mimo-tts",
        "tools": [
          "mimo_tts_synthesize",
          "mimo_tts_voice_design",
          "mimo_tts_voice_clone"
        ],
        "mode": "result",
        "entry": "./dist/chat-card/chat-card.js"
      }
    ],
    "configSchema": [
      {
        "key": "apiKey",
        "label": "API Key",
        "type": "string",
        "default": "",
        "placeholder": "小米 MiMo 开放平台 API Key",
        "help": "在 https://mimo.mi.com 控制台获取",
        "sensitive": true
      },
      {
        "key": "baseUrl",
        "label": "API 端点",
        "type": "string",
        "default": "https://api.xiaomimimo.com/v1",
        "placeholder": "https://api.xiaomimimo.com/v1"
      },
      {
        "key": "defaultVoice",
        "label": "默认音色",
        "type": "select",
        "default": "冰糖",
        "options": [
          {
            "label": "冰糖（中文女声）",
            "value": "冰糖"
          },
          {
            "label": "茉莉（中文女声）",
            "value": "茉莉"
          },
          {
            "label": "苏打（中文男声）",
            "value": "苏打"
          },
          {
            "label": "白桦（中文男声）",
            "value": "白桦"
          },
          {
            "label": "Mia（英文女声）",
            "value": "Mia"
          },
          {
            "label": "Chloe（英文女声）",
            "value": "Chloe"
          },
          {
            "label": "Milo（英文男声）",
            "value": "Milo"
          },
          {
            "label": "Dean（英文男声）",
            "value": "Dean"
          }
        ]
      },
      {
        "key": "outputMode",
        "label": "音频输出方式",
        "type": "select",
        "default": "file",
        "options": [
          {
            "label": "保存文件并返回路径（推荐，聊天卡片可播放）",
            "value": "file"
          },
          {
            "label": "返回 base64 内联（短文本/特殊场景）",
            "value": "base64"
          }
        ]
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "appConfigRead": true,
    "appConfigWrite": true,
    "network": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/mimo-tts",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/mimo-tts/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@mimo-tts-v0.1.1/plugins/mimo-tts/mimo-tts.zip"
  }
}
