{
  "id": "battle-mode",
  "name": "Battle Mode",
  "version": "0.1.1",
  "description": "为学习而战的对抗式辩论：角色卡 + 世界观跳伞 + 维度骰子 + AI主持提示词。MCP 工具（battle_setup/roll/prompt/report）让 AI 在对话里直接开战，面板可操作可发战报到聊天。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "battle-mode.panel",
        "area": "activityBar",
        "panelType": "battle-mode",
        "icon": "Target",
        "labelKey": "labels.battlePanel",
        "labelDefault": "Battle",
        "order": 80
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "mcpServers": [
      {
        "id": "battle-mode-mcp",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js",
          "{{appConfigDir}}"
        ]
      }
    ]
  },
  "permissions": {
    "appConfigRead": true,
    "appConfigWrite": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/battle-mode",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/battle-mode/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/battle-mode/battle-mode.zip"
  }
}
