{
  "id": "codebuddy",
  "name": "CodeBuddy Engine",
  "version": "0.2.0",
  "description": "腾讯 CodeBuddy CLI 引擎适配器（engine-v1），支持 hy4free/hy4std/hy3/deepseek-v4.1-flash/glm-5.3 等模型。v0.2.1：修正模型目录为 CLI 权威清单；流式回放去重修复重复渲染。",
  "enabledByDefault": false,
  "contributes": {
    "engines": [
      {
        "id": "codebuddy",
        "name": "CodeBuddy",
        "description": "腾讯 CodeBuddy CLI — 混元 hy4free 等多模型（免费）",
        "cli": {
          "command": "codebuddy",
          "args": [],
          "installGuide": "npm install -g @tencent-ai/codebuddy-code"
        },
        "npmPackage": "@tencent-ai/codebuddy-code",
        "protocol": "command",
        "sessionFlags": "omp",
        "mcpConsumption": "none",
        "models": ["hy4free", "hy4std", "hy3", "hy3-x", "deepseek-v4.1-flash", "glm-5.3", "glm-5.3-flash", "glm-5.2", "space-bunny", "minimax-m3.1-flash", "minimax-m2.7", "kimi-k3.1-pro", "kimi-k3-1", "kimi-k2.8-preview", "deepseek-v4-pro", "step-5-preview", "mimo-v2.6-pro"],
        "adapter": {
          "entry": "adapter.js",
          "runtime": "node",
          "protocol": "engine-v1"
        },
        "capabilities": {
          "tools": true,
          "streaming": true,
          "interrupt": true,
          "resume": true
        }
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "aiToolAccess": true
  }
}
