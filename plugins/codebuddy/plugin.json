{
  "id": "codebuddy",
  "name": "CodeBuddy Engine",
  "version": "0.3.1",
  "description": "腾讯 CodeBuddy CLI 引擎适配器（engine-v1）。v0.3.0：续聊修复（响应帧先于 session_end 发出——resume_token 不再被宿主 reader 丢弃）；tool_use 参数 input_json_delta 分片聚合补发（Edit/Write 的 file_path/old_string 到达前端，悬浮岛文件变更统计生效）。 v0.3.1：resume_token 采集竞态修复——close≠stdout消费完，CLI result 帧行可能仍在管道缓冲，响应帧曾带空/旧 token（续聊退化新会话的真根因）；stdout drain 完才收尾。",
  "enabledByDefault": false,
  "contributes": {
    "engines": [
      {
        "id": "codebuddy",
        "name": "CodeBuddy",
        "description": "腾讯 CodeBuddy CLI — 混元 hy4free 等多模型（免费）",
        "cli": {
          "command": "codebuddy",
          "args": [],
          "installGuide": "npm install -g @tencent-ai/codebuddy-code"
        },
        "npmPackage": "@tencent-ai/codebuddy-code",
        "protocol": "command",
        "sessionFlags": "omp",
        "mcpConsumption": "none",
        "models": [
          "hy4free",
          "hy4std",
          "hy3",
          "hy3-x",
          "deepseek-v4.1-flash",
          "glm-5.3",
          "glm-5.3-flash",
          "glm-5.2",
          "space-bunny",
          "minimax-m3.1-flash",
          "minimax-m2.7",
          "kimi-k3.1-pro",
          "kimi-k3-1",
          "kimi-k2.8-preview",
          "deepseek-v4-pro",
          "step-5-preview",
          "mimo-v2.6-pro"
        ],
        "sessionConfig": {
          "selectors": [
            "agent",
            "model",
            "effort",
            "permission",
            "profile"
          ],
          "effortOptions": [
            {
              "value": "",
              "label": "不设置",
              "description": "使用 CLI 默认级别"
            },
            {
              "value": "minimal",
              "label": "最低",
              "description": "极简思考，快速响应"
            },
            {
              "value": "low",
              "label": "低",
              "description": "快速响应，适合简单问题"
            },
            {
              "value": "medium",
              "label": "中",
              "description": "平衡速度和质量"
            },
            {
              "value": "high",
              "label": "高",
              "description": "深入思考，适合复杂问题"
            },
            {
              "value": "xhigh",
              "label": "极高",
              "description": "适合复杂编码和长程 Agent 任务"
            },
            {
              "value": "max",
              "label": "最高",
              "description": "全力以赴，最高质量输出"
            }
          ],
          "permissionOptions": [
            {
              "value": "",
              "label": "不设置",
              "description": "使用 CLI 默认权限策略"
            },
            {
              "value": "default",
              "label": "默认",
              "description": "敏感操作需要确认"
            },
            {
              "value": "auto",
              "label": "自动",
              "description": "安全操作自动批准，高风险仍受限"
            },
            {
              "value": "acceptEdits",
              "label": "接受编辑",
              "description": "自动接受文件编辑"
            },
            {
              "value": "plan",
              "label": "规划",
              "description": "仅规划不执行"
            },
            {
              "value": "dontAsk",
              "label": "拒绝危险",
              "description": "拒绝需要确认的危险操作"
            },
            {
              "value": "bypassPermissions",
              "label": "跳过权限（高风险）",
              "description": "绕过所有权限检查"
            }
          ]
        },
        "adapter": {
          "entry": "adapter.js",
          "runtime": "node",
          "protocol": "engine-v1"
        },
        "capabilities": {
          "tools": true,
          "streaming": true,
          "interrupt": true,
          "resume": true
        }
      }
    ],
    "views": [
      {
        "id": "codebuddy.panel",
        "area": "activityBar",
        "panelType": "codebuddyPanel",
        "icon": "Bot",
        "labelKey": "plugins.codebuddy",
        "labelDefault": "CodeBuddy",
        "order": 91
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": false
    }
  },
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "aiToolAccess": true
  }
}
