{
  "id": "omp-engine-adapter",
  "name": "Oh My Pi Adapter (engine-v1)",
  "version": "0.1.0",
  "description": "OMP 引擎适配器进程示例 —— 通过 engine-v1 协议演示插件引擎适配器模式。加新引擎只需写一个适配器进程，不改 Polaris 核心。",
  "enabledByDefault": false,
  "contributes": {
    "engines": [
      {
        "id": "omp-adapter-demo",
        "name": "OMP Adapter Demo",
        "description": "演示 engine-v1 适配器协议的 OMP 引擎（mock 模式，不连接真实 omp）",
        "cli": {
          "command": "omp",
          "installGuide": "适配器演示引擎，无需真实 omp CLI"
        },
        "adapter": {
          "entry": "engine.js",
          "runtime": "node",
          "protocol": "engine-v1"
        },
        "capabilities": {
          "tools": true,
          "streaming": true,
          "interrupt": true,
          "resume": true
        }
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin"
  }
}