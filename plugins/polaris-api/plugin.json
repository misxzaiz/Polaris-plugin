{
  "id": "polaris-api",
  "name": "Polaris API",
  "version": "1.1.0",
  "description": "轻量级 API 请求客户端：多 Tab、智能响应（对象树/表格/路径下钻/增强过滤）、集合管理、cURL/Postman/OpenAPI 导入、AI 协同（复用宿主 AI+MCP）",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "polaris-api.panel",
        "area": "activityBar",
        "panelType": "polarisApi",
        "icon": "Beaker",
        "labelKey": "plugins.polarisApi",
        "labelDefault": "API",
        "order": 85
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "polaris-api-proxy",
        "type": "http",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/server.js", "{{port}}"],
        "port": 9870,
        "healthCheck": "/__health",
        "healthCheckTimeout": 3000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 3,
        "description": "Polaris API 代理服务（跨域转发 + 静态资源）"
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "network": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/polaris-api",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/polaris-api/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/polaris-api/polaris-api.zip"
  }
}