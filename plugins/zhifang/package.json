    "esbuild": "^0.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174"
  }
}
