{
  "id": "mock-server",
  "name": "Mock 接口台",
  "version": "0.1.0",
  "description": "把本机 127.0.0.1:9868 变成一套随编随用的假接口：后端没就绪前端先开工、联调造不出边界数据、演示需要可控响应——对话或表单建路由（路径参数/通配符），{{模板}}造真实感数据（中文姓名/手机号/时间/请求回显），延迟+错误率注入造边界，未匹配路径回 404 诊断体，请求全留痕（敏感头自动脱敏）；OpenAPI JSON 一键导入成路由，内置试金石自检 7 项打真请求验证。AI 经 MCP 八工具对话式管理：建/改/删/试发/看历史/自检/导入。零外部服务零依赖，数据不出本机。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "mock-server.panel",
        "area": "activityBar",
        "panelType": "mockServer",
        "icon": "Code2",
        "labelKey": "plugins.mockServer",
        "labelDefault": "Mock 接口台",
        "order": 96
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "mock-server-service",
        "type": "http",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/service/main.js", "{{port}}", "{{appConfigDir}}"],
        "port": 9868,
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 10,
        "description": "本机 mock 服务（127.0.0.1 数据面 + kv 控制面；路由 3s 热更，历史内存 500 条）"
      }
    ],
    "mcpServers": [
      {
        "id": "mock-server",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": ["{{pluginDir}}/mcp/server.js", "{{appConfigDir}}"]
      }
    ]
  },
  "permissions": {
    "appConfigRead": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/mock-server",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/mock-server/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/mock-server/mock-server.zip"
  }
}
