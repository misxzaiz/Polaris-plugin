{
  "id": "mcp-probe",
  "name": "MCP 调试台",
  "version": "0.1.0",
  "description": "MCP 服务器调试工作台：宿主已装插件的 MCP 工具零成本直查（cap.mcp 代理，零重复 spawn），外部 stdio/streamable-HTTP 服务器一键接入并常驻档案；工具清单→schema 自动表单→调用→看 JSON/耗时，体检（握手延迟/schema 卫生检查/绝不自动调用）、快照 diff 抓 schema 漂移、调用历史重放；Claude 式配置（~/.claude、.mcp.json）一键导入；AI 经七工具代劳全程调试。全程本机 127.0.0.1，零外部服务。",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "mcp-probe.panel",
        "area": "activityBar",
        "panelType": "mcpProbe",
        "icon": "SquareTerminal",
        "labelKey": "plugins.mcpProbe",
        "labelDefault": "MCP 调试台",
        "order": 74
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "probe-service",
        "type": "http",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/service/probe.js",
          "{{port}}",
          "{{appConfigDir}}"
        ],
        "healthCheck": "/__health",
        "healthCheckTimeout": 5000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 10,
        "description": "MCP 连接池与调试引擎（stdio/HTTP 客户端，唯一 spawn 所有者）"
      }
    ],
    "mcpServers": [
      {
        "id": "mcp-probe",
        "transport": "stdio",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/mcp/server.js",
          "{{appConfigDir}}"
        ]
      }
    ]
  },
  "permissions": {
    "network": true,
    "appConfigRead": true,
    "aiToolAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/mcp-probe",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/mcp-probe/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/mcp-probe/mcp-probe.zip"
  }
}
