{
  "name": "qr-desk-panel",
  "version": "0.1.0",
  "private": true,
  "description": "qr-desk 插件(打包用)：二维码工作台——生成/解码/载荷感知/迁移码/批量",
  "scripts": {
    "build:service": "esbuild service/main-src.js --bundle --platform=node --format=cjs --outfile=service/main.js",
    "build:mcp": "esbuild mcp/server-src.js --bundle --platform=node --format=cjs --outfile=mcp/server.js",
    "build:panel": "esbuild src/index.tsx --bundle --format=esm --outfile=dist/panel.js --jsx=automatic --external:react --external:react/jsx-runtime",
    "build": "npm run build:service && npm run build:mcp && npm run build:panel",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-tests.mjs && node test/mcp-verify.mjs && node test/service-verify.mjs"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "esbuild": "^0.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.5.0"
  },
  "type": "commonjs"
}
