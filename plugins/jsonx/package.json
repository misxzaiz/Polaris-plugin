{
  "name": "polaris-jsonx-panel",
  "version": "1.0.0",
  "private": true,
  "description": "JSON Explorer 面板与卡片（打包用）",
  "scripts": {
    "build:panel": "esbuild src/Panel.tsx --bundle --format=esm --outfile=dist/panel.js --jsx=automatic --external:react --external:react/jsx-runtime",
    "build:card": "esbuild src/Card.tsx --bundle --format=esm --outfile=dist/card.js --jsx=automatic --external:react --external:react/jsx-runtime",
    "build": "npm run build:panel && npm run build:card"
  },
  "devDependencies": { "esbuild": "^0.23.0" }
}
