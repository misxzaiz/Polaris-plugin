{
  "id": "emotion-ball",
  "name": "Emotion Ball",
  "version": "0.4.0",
  "description": "32-state SVG emotion ball with eye-white+pupil+mouth rendering, ribbons, confetti, gaze tracking, and OpenAI-compatible AI chat integration. v3: cute baby-proportioned eyes, dual highlights, expressive mouth.",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "emotion-ball.panel",
        "area": "activityBar",
        "panelType": "emotion-ball",
        "icon": "Target",
        "labelKey": "labels.panel",
        "labelDefault": "Emotion Ball",
        "order": 85
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": false
    }
  },
  "permissions": {
    "workspaceRead": true,
    "appConfigRead": true,
    "networkAccess": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/emotion-ball",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/emotion-ball/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/emotion-ball/emotion-ball.zip"
  }
}