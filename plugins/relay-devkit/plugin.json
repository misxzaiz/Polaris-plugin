{
  "id": "relay-devkit",
  "name": "RELAY DevKit",
  "version": "1.4.0",
  "description": "开发者工具箱：API 客户端、JSON 格式化、SQL 工具、数据库管理、时间戳转换。v1.4.0: 移除内置 AI 助手（独立成插件发布）；面板模式 API 请求改走宿主 cap.http 直发（携带 Cookie/UA/Referer 等禁发头、无 CORS/混合内容限制，二进制 base64 返回预览下载）。v1.3.3: 数据库面板模式改走宿主 cap.http 直连（规避 iframe 混合内容/CORS/禁发头）；mysql2 内联 vendor 离线打包，装完即用无需 npm i。v1.3.2: 修复代理跨域失败——透传时剥离目标服务器自身 CORS 头，消除双 Access-Control-Allow-Origin 冲突，浏览器可正常读取响应。v1.3.1: 直连模式含浏览器禁发头时强制拦截并引导开代理，修复静默剥离致登录失效；cURL 导入自动识别禁发头。v1.3.0: 代理模式禁发头后端注入（Cookie/UA/Referer 经 X-Relay-H-* 还原，cURL 导入发送完整等效）",
  "enabledByDefault": true,
  "contributes": {
    "views": [
      {
        "id": "relay-devkit.panel",
        "area": "activityBar",
        "panelType": "relayDevkit",
        "icon": "Terminal",
        "labelKey": "plugins.relayDevkit",
        "labelDefault": "DevKit",
        "order": 80
      }
    ],
    "panel": {
      "entry": "./dist/panel.js",
      "supportsFullscreen": true
    },
    "services": [
      {
        "id": "relay-server",
        "type": "http",
        "command": "node",
        "argsTemplate": [
          "{{pluginDir}}/server.js",
          "{{port}}"
        ],
        "port": 9860,
        "healthCheck": "/__health",
        "healthCheckTimeout": 3000,
        "autoStart": true,
        "restartOnFailure": true,
        "maxRestarts": 3,
        "description": "RELAY HTTP 服务（静态资源 + /__proxy 跨域代理 + /__db 数据库桥接）"
      }
    ]
  },
  "permissions": {
    "workspaceRead": true,
    "network": true
  },
  "origin": {
    "repository": "https://github.com/misxzaiz/Polaris-plugin",
    "homepage": "https://github.com/misxzaiz/Polaris-plugin/tree/main/plugins/relay-devkit",
    "updateUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/relay-devkit/update.json",
    "downloadUrl": "https://cdn.jsdelivr.net/gh/misxzaiz/Polaris-plugin@main/plugins/relay-devkit/relay-devkit.zip"
  }
}
