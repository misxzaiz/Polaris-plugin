# ---- 版本控制 ----
.git/
.gitignore

# ---- 本机/IDE 配置 ----
.polaris/
_write_ai_context.mjs

# ---- 开发依赖 ----
# 顶层 node_modules/ 排除；relay_server/vendor/ 内联的运行时依赖（mysql2 离线包）必须保留。
# /package.json 仅排除插件根清单；vendor 内各依赖包的 package.json（依赖解析必需）保留。
node_modules/
!relay_server/vendor/node_modules/
/package.json
/package-lock.json

# ---- vendor 内非运行时文件（类型声明/文档，运行时不需要，压缩体积）----
*.d.ts
typings/
README*
LICENSE*
License
*.md

# ---- 面板源码（构建产物已包含，源码不进包）----
src/
build.js

# ---- 文档（保留在仓库，不进包）----
docs/

# ---- 构建辅助 ----
dist/panel.js.map
make-zip.js
make-zip.cjs

# ---- 历史遗留：Python 实现 ----
*.py
*.pyc
__pycache__/

# ---- 独立运行脚本（Polaris service 自动管理，不需要）----
start.bat
start.txt
serve.sh
stop.sh
server.py

# ---- 测试/验证文件 ----
relay-verify.js
relay-verify-backend.mjs
relay-verify.png
relay-media.png
relay-verify-multitable.png

# ---- 演示/示例数据（工具无关）----
media.json
nested.json
users.json
index.html
showcase.html