node_modules/
# vendor 内联的运行时依赖（mysql2 等离线包）必须随仓库分发，豁免其 node_modules
!plugins/relay-devkit/relay_server/vendor/node_modules/
*.log

# 敏感本地配置（含 token/session，禁止提交）
.polaris/
.claude/

# 插件打包临时目录
plugins/*/.tmp-pack-*

# 安装/改名前的旧版插件备份（本地临时产物，禁止提交）
.tmp-install-backup/
.tmp-rename-backup/

# Blender 建模插件生成目录（测试输出，不提交）
plugins/blender-modeling/generated/
plugins/blender-modeling/cache/
plugins/blender-modeling/scripts/__pycache__/

# Polaris 会话交接导出（本地工作产物，禁止提交）
.polaris-handoff/

# animation-2d 渲染输出（mp4/帧检查图，体积大且可再生）
plugins/animation-2d/out/

# douyin-publish 运行时状态（发布记录，含本机路径与 itemId）
plugins/douyin-publish/state/
*.harness-bundle*
