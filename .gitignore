node_modules/
# vendor 内联的运行时依赖（mysql2 等离线包）必须随仓库分发，豁免其 node_modules
!plugins/relay-devkit/relay_server/vendor/node_modules/
*.log

# 敏感本地配置（含 token/session，禁止提交）
.polaris/
.claude/

# 插件打包临时目录
plugins/*/.tmp-pack-*

# Blender 建模插件生成目录（测试输出，不提交）
plugins/blender-modeling/generated/
plugins/blender-modeling/cache/
plugins/blender-modeling/scripts/__pycache__/
